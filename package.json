{
  "name": "arxia-med-redesign",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "prebuild": "vitest run",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && rm -rf dist/modelos dist/prompts-rt dist/ubs-sus dist/dados && mkdir -p dist/modelos dist/prompts-rt dist/ubs-sus/prompts dist/dados && cp server/modelos/* dist/modelos/ && cp server/prompts-rt/*.txt dist/prompts-rt/ && cp server/ubs-sus/prompts/*.txt dist/ubs-sus/prompts/ && cp -r server/dados/* dist/dados/",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "validar:catalogo": "node dados/validar-catalogo.js",
    "homologar": "npx tsx scripts/homologar-catalogo.ts",
    "homologar:aplicar": "npx tsx scripts/homologar-catalogo.ts --aplicar",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@trpc/server": "^11.8.0",
    "axios": "^1.12.0",
    "cookie": "^1.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.3.0",
    "jose": "6.1.0",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.5",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^1.13.3",
    "yaml": "2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "add": "^2.0.6",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "pnpm": "^10.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7",
      "fast-xml-parser": ">=5.3.5",
      "tar": ">=7.5.19",
      "dompurify": ">=3.4.12",
      "mermaid": ">=11.16.1",
      "body-parser": ">=1.20.6"
    }
  }
}
